# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values before running:
#   cp .env.example .env
# Then start everything:
#   docker compose up --build
# ─────────────────────────────────────────────────────────────────

# Port the app is accessible on your host (http://localhost:FRONTEND_PORT)
FRONTEND_PORT=3000

# These are baked into the React bundle at build time.
# If you host behind a domain replace localhost:3000 with your domain.
VITE_API_BASE_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000

# CORS origin the backend will accept (should match where users open the app)
FRONTEND_URL=http://localhost:3000
