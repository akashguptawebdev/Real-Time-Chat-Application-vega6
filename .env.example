# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values before running:
#   cp .env.example .env
# Then start everything:
#   docker compose up --build
# ─────────────────────────────────────────────────────────────────

# Port the app is accessible on your host
FRONTEND_PORT=443

# Baked into the React bundle at build time — must match your public domain
VITE_API_BASE_URL=https://backend.chatly.vedantaa.in/api
VITE_SOCKET_URL=https://backend.chatly.vedantaa.in

# CORS origin the backend will accept
FRONTEND_URL=https://chatly.vedantaa.in
